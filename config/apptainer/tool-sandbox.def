Bootstrap: docker
From: python@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git bash ca-certificates
    rm -rf /var/lib/apt/lists/*

%environment
    export HOME=/tmp
    export PATH=/usr/local/bin:/usr/bin:/bin

%labels
    org.opencontainers.image.title Local AI restricted tool sandbox
    org.opencontainers.image.description Immutable Python, Git and shell environment for Apptainer containment
