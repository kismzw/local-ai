# Apptainer / native application versions. No Docker or sudo is required.
# Leave empty to autodetect apptainer, then singularity.
APPTAINER_BIN=
LLAMA_IMAGE=./images/llama-server-cuda.sif
TOOL_IMAGE=./images/tool-sandbox.sif
SEARXNG_IMAGE=./images/searxng.sif
DOCLING_IMAGE=./images/docling-serve-cu128.sif
OPEN_WEBUI_VERSION=0.11.0

# Host exposure: loopback only. Apptainer uses the host network by default, so
# there is no Docker-style port mapping.
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=3000
# Optional Firefox executable used by ./local-ai open. Leave blank to detect
# firefox on PATH or the system Flatpak Firefox launcher.
FIREFOX_BIN=
LLAMA_SERVER_BIND=127.0.0.1
LLAMA_SERVER_PORT=8080
EMBEDDING_SERVER_PORT=8081
TOOL_BRIDGE_BIND=127.0.0.1
TOOL_BRIDGE_PORT=8090
SEARXNG_PORT=8082
DOCLING_GATE_PORT=5001
DOCLING_PORT=5002

# All persistent paths are user-owned and relative to this repository by default.
MODEL_DIR=./models
DATA_DIR=./data
OPEN_WEBUI_DATA_DIR=./data/open-webui
TOOL_AUDIT_DIR=./data/tool-audit
SEARXNG_CACHE_DIR=./data/searxng/cache
DOCLING_ARTIFACTS_DIR=./data/docling/artifacts
DOCLING_AUDIT_DIR=./data/docling/audit
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
MODEL_CONTEXT_SIZE=65536
MODEL_PARALLELISM=1
MODEL_GPU_LAYERS=all
MODEL_THREADS=8
MODEL_BATCH_SIZE=2048
MODEL_UBATCH_SIZE=512
MODEL_KV_CACHE_K=q8_0
MODEL_KV_CACHE_V=q8_0

# Generated by scripts/setup.sh if left as CHANGE_ME. They never leave .env.
LLAMA_API_KEY=CHANGE_ME
EMBEDDING_API_KEY=CHANGE_ME
TOOL_SANDBOX_API_KEY=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME
DOCLING_GATE_API_KEY=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME

# Open WebUI uses the embedding service through standard OpenAI-compatible API.
RAG_EMBEDDING_MODEL=qwen3-embedding-0.6b
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150

# ChatGPT-style web search. SearXNG has outbound network access; the execution
# sandbox remains isolated. Open WebUI's SSRF guard stays enabled.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=1
WEB_LOADER_CONCURRENT_REQUESTS=2
WEB_LOADER_TIMEOUT_SECONDS=20
WEB_FETCH_MAX_CONTENT_LENGTH=40000

# Docling GPU RAG. The gate serializes ingestion and waits for llama.cpp to be
# idle on a best-effort basis before forwarding a document conversion request.
DOCLING_GATE_IDLE_SECONDS=10
DOCLING_GATE_POLL_SECONDS=5
DOCLING_GATE_MAX_WAIT_SECONDS=600
DOCLING_GATE_MAX_RETRIES=3
DOCLING_MAX_SYNC_WAIT_SECONDS=600

# One explicit host directory is the only writable sandbox bind. This Codex-style
# default covers the owner's local project directory; narrow it for a stricter
# single-project boundary.
WORKSPACE_DIR=/home/skei/Documents/vscode
# Optional read-only data source, exposed in the tool container as /data. This
# must be an explicit absolute host directory; it is never writable by tools.
TOOL_DATA_DIR=
# Colon-separated sensitive paths below WORKSPACE_DIR to mask with an empty
# read-only file. Example: /home/alice/Projects/.env
TOOL_HIDDEN_PATHS=
# Limit each sandbox result injected into a chat. Large source listings should
# be narrowed with rg/sed rather than filling the model context.
TOOL_MAX_OUTPUT_CHARS=6000
TOOL_WRITE_MODE=read_write
TOOL_BRIDGE_ENABLED=true
# This host passed ./tests/tool-isolation.sh. Re-run it after Apptainer, kernel,
# or site-policy changes; use unverified if the network namespace probe fails.
TOOL_NETWORK_MODE=isolated
