[Unit]
Description=Local AI llama.cpp chat service
PartOf=local-ai.target

[Service]
Type=simple
EnvironmentFile=@LOCAL_AI_ROOT_SYSTEMD@/run/local-ai.env
ExecStartPre="@LOCAL_AI_ROOT@/scripts/verify-service-artifact.sh" llama
ExecStart="@LOCAL_AI_ROOT@/scripts/service-command.sh" llama-server
ExecStartPost="@LOCAL_AI_ROOT@/scripts/health-check.sh" llama-server
Restart=on-failure
RestartSec=5
